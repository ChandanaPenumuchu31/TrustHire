            # Use default legitimate profile
            default = self.company_reviews.get('default_legitimate', {})
            verification_result['reviews'] = {
                'glassdoor': {'rating': default.get('glassdoor', 3.8), 'reviews': default.get('reviews', 150)},
                'indeed': {'rating': default.get('indeed', 3.7), 'reviews': 75},
                'google': {'rating': default.get('google', 3.9), 'reviews': 50},
                'ambitionbox': {'rating': 0.0, 'reviews': 0},
                'average_rating': default.get('rating', 3.8),
                'total_reviews': default.get('reviews', 150),
                'sources_found': 0,
                'sentiment': 'neutral',
                'simulated': True
            }
            

    def __init__(self):
        """Initialize fast ML-based fraud detector"""
        # ML Components
        self.vectorizer = TfidfVectorizer(max_features=100, stop_words='english')
        self.ml_model = RandomForestClassifier(n_estimators=10, max_depth=5, random_state=42)
        self.scaler = StandardScaler()
        
        # Load company reviews database from file (FAST!)
        self.company_reviews = self._load_company_reviews()
        
        # Initialize Gemini AI
        self.llm_analyzer = get_llm_analyzer()
        
        # Train simple ML model for fraud detection (one-time, fast)
        self._train_ml_model()
        
        logger.info("🛡️ Fast ML Fraud Detector initialized")
        logger.info(f"   📊 Company Reviews: {len(self.company_reviews)} in database")
        logger.info(f"   🤖 ML Model: Random Forest Trained")
        logger.info(f"   🤖 Gemini AI: {'ENABLED' if self.llm_analyzer.enabled else 'DISABLED'}")
        
    def _load_company_reviews(self) -> Dict:
        """Load company reviews from JSON file (FAST)"""
        try:
            reviews_file = Path(__file__).parent.parent / 'data' / 'company_reviews.json'
            with open(reviews_file, 'r') as f:
                data = json.load(f)
                logger.info(f"✅ Loaded {len(data['companies'])} company reviews from file")
                return data
        except Exception as e:
            logger.warning(f"Failed to load reviews file: {e}. Using defaults.")
            return {'companies': {}, 'default_legitimate': {}, 'default_suspicious': {}}
    
    def _train_ml_model(self):
        """Train simple ML model for fast fraud detection"""
        # Training data: fraud indicators
        fraud_samples = [
            'guaranteed income work from home', 'pay upfront training fee',
            'urgent hiring immediate start', 'send money western union',
            'whatsapp interview telegram', 'easy money no experience',
            'unlimited earning get rich', 'registration fee required'
        ]
        legit_samples = [
            'software engineer position', 'full stack developer role',
            'senior data scientist', 'product manager opportunity',
            'marketing specialist', 'business analyst position',
            'frontend engineer react', 'backend developer python'
        ]
        
        X_text = fraud_samples + legit_samples
        y = [1] * len(fraud_samples) + [0] * len(legit_samples)
        
        # Train vectorizer and model
        X_vectorized = self.vectorizer.fit_transform(X_text)
        self.ml_model.fit(X_vectorized, y)
        logger.info("✅ ML model trained successfully")
    
    def verify_company_online(self, company_name: str, role: str = '') -> Dict:

    def predict(self, job_data: Dict) -> Dict:
        """
        Main prediction with comprehensive fraud detection using Gemini AI and real reviews
        Returns: Complete fraud analysis with all details
        """
        try:
            # 1. Verify company online WITH REAL-TIME REVIEW SCRAPING
            company_name = job_data.get('company', '')
            job_title = job_data.get('title', '')
            company_verification = self.verify_company_online(company_name, role=job_title)
            
            # 2. Check job availability
            job_url = job_data.get('url', '')
            job_availability = self.check_job_availability(job_url)
            
            # 3. USE GEMINI AI for advanced fraud analysis (if enabled)
            if self.llm_analyzer and self.llm_analyzer.enabled:
                logger.info(f"🤖 Using Gemini AI to analyze: {job_data.get('title')}")
                gemini_analysis = self.llm_analyzer.analyze_job_fraud(
                    job_data, 
                    company_verification['reviews']
                )
            else:
                # Fallback to rule-based analysis
                gemini_analysis = self.llm_analyze_fraud(job_data)
            
            # 4. Calculate final trust score
            trust_score = 1.0
            fraud_reasons = []
            
            # Company verification impact (40% weight)
            if not company_verification['is_real']:
                trust_score -= 0.4
                fraud_reasons.append(f"❌ Company Verification FAILED: {company_verification['reason']}")
            else:
                if company_verification['confidence'] < 0.6:
                    trust_score -= 0.2
                fraud_reasons.append(f"✅ Company Verified: {company_verification['reason']}")
                
            # Add review insights (real or synthetic)
            reviews = company_verification['reviews']
            if reviews:
                if reviews.get('synthetic', False):
                    # Synthetic/AI-generated review analysis
                    fraud_reasons.append(f"🤖 AI Review Analysis: {reviews.get('analysis', 'No reviews found online')}")
                    if reviews.get('fraud_indicators'):
                        for indicator in reviews['fraud_indicators'][:3]:
                            fraud_reasons.append(f"  ⚠️ {indicator}")
                    if reviews.get('likely_legitimate') == False:
                        trust_score -= 0.2  # Penalize if LLM says likely fake
                        fraud_reasons.append("  🚨 LLM Assessment: Company appears suspicious")
                elif reviews.get('average_rating', 0) > 0:
                    # Real reviews found
                    fraud_reasons.append(
                        f"⭐ Company Reviews: {reviews['average_rating']}/5.0 "
                        f"({reviews['total_reviews']} reviews from {reviews['sources_found']} sources)"
                    )
                    # Show individual platform reviews
                    for platform in ['glassdoor', 'indeed', 'google', 'ambitionbox']:
                        platform_data = reviews.get(platform, {})
                        if platform_data and platform_data.get('rating', 0) > 0:
                            fraud_reasons.append(
                                f"  • {platform.title()}: {platform_data['rating']}/5.0 "
                                f"({platform_data.get('reviews', 0)} reviews)"
                            )
                else:
                    fraud_reasons.append("⚠️ No company reviews found - Cannot verify reputation")
            
            # Job availability impact (10% weight)
            if job_availability['is_available'] == False:
                trust_score -= 0.1
                fraud_reasons.append(f"⚠️ Job Status: {job_availability['reason']}")
            elif job_availability['is_available'] == True:
                fraud_reasons.append(f"✅ Job Status: {job_availability['reason']}")
            
            # Gemini AI analysis impact (50% weight)
            fraud_probability = gemini_analysis.get('fraud_probability', 0.5)
            trust_score -= (fraud_probability * 0.5)
            
            # Add Gemini's reasoning
            if gemini_analysis.get('reasoning'):
                fraud_reasons.append(f"🤖 Gemini AI Analysis: {gemini_analysis['reasoning']}")
            
            if gemini_analysis.get('red_flags'):
                fraud_reasons.append(f"🚩 Red Flags: {', '.join(gemini_analysis['red_flags'][:3])}")
            
            if gemini_analysis.get('green_flags'):
                fraud_reasons.append(f"✅ Positive Indicators: {', '.join(gemini_analysis['green_flags'][:2])}")
            
            # Ensure trust score is between 0 and 1
            trust_score = max(0.0, min(1.0, trust_score))
            
            # Determine if fraudulent (threshold: 50%)
            is_fraudulent = trust_score < 0.5
            
            # Build detailed result
            result = {
                'trust_score': trust_score,
                'is_fraudulent': is_fraudulent,
                'fraud_confidence': 1.0 - trust_score if is_fraudulent else 0.0,
                'fraud_signals': gemini_analysis.get('red_flags', []),
                'detailed_reasons': fraud_reasons,
                'company_verification': company_verification,
                'job_availability': job_availability,
                'llm_analysis': gemini_analysis,
                'gemini_recommendation': gemini_analysis.get('recommendation', ''),
                'final_verdict': self._get_verdict(trust_score, company_verification, job_availability)
            }
            
            logger.info(f"✅ Analysis complete: {job_data.get('title')} - Trust Score: {trust_score:.0%}")
            
            return result
            
        except Exception as e:
            logger.error(f"Error in prediction: {e}")
            return {
                'trust_score': 0.5,
                'is_fraudulent': False,
                'fraud_confidence': 0.0,
                'fraud_signals': [],
                'detailed_reasons': [f'Error: {str(e)}'],
                'company_verification': {},
                'job_availability': {},
                'llm_analysis': {},
                'final_verdict': 'Unable to analyze'
            }
    
    def _search_company_online(self, company_name: str) -> float:
        """Search for company online and return confidence score"""
        try:
            confidence = 0.0
            company_lower = company_name.lower()
            
            tech_indicators = ['tech', 'software', 'systems', 'solutions', 'consulting', 
                              'services', 'digital', 'labs', 'innovations', 'data',
                              'cloud', 'cyber', 'analytics', 'ai', 'ml']
            
            if any(indicator in company_lower for indicator in tech_indicators):
                confidence += 0.2
            
            word_count = len(company_name.split())
            if 2 <= word_count <= 5:
                confidence += 0.1
            
            if company_name[0].isupper():
                confidence += 0.1
            
            return min(confidence, 0.4)
        except:
            return 0.0
    
    def _generate_synthetic_reviews(self, company_name: str, role: str = '') -> Dict:
        """Generate synthetic company review analysis using LLM or rule-based logic"""
        
        # Try to generate reviews using Gemini AI
        if self.llm_analyzer and self.llm_analyzer.enabled:
            try:
                synthetic_analysis = self._llm_generate_reviews(company_name, role)
                if synthetic_analysis:
                    logger.info(f"✅ Generated synthetic reviews for {company_name} using LLM")
                    return synthetic_analysis
            except Exception as e:
                logger.warning(f"LLM review generation failed: {e}. Using rule-based.")
        
        # Fallback to rule-based synthetic reviews
        logger.info(f"📊 Creating rule-based synthetic reviews for {company_name}")
        return self._get_simulated_reviews(company_name, role)
    
    def _get_simulated_reviews(self, company_name: str, role: str = '') -> Dict:
        """Simulate company reviews using rule-based heuristics"""
        # Red flags: no online presence suggests potential fraud
        is_suspicious = len(company_name) < 5 or any(word in company_name.lower() for word in 
            ['hiring', 'confidential', 'solutions', 'consulting', 'services'])
        
        if is_suspicious:
            return {
                'glassdoor': {'rating': 0, 'reviews': 0},
                'google': {'rating': 0, 'reviews': 0},
                'indeed': {'rating': 0, 'reviews': 0},
                'ambitionbox': {'rating': 0, 'reviews': 0},
                'average_rating': 0.0,
                'total_reviews': 0,
                'sources_found': 0,
                'synthetic': True,
                'analysis': f"⚠️ WARNING: '{company_name}' has NO online presence or reviews. This is a major red flag for potential fraud.",
                'fraud_indicators': [
                    'No company reviews found on any platform',
                    'No online presence detected',
                    'Company name appears generic or suspicious',
                    'High likelihood of fake job posting'
                ]
            }
        else:
            # Generate plausible synthetic data for potentially real but unknown companies
            return {
                'glassdoor': {'rating': 0, 'reviews': 0},
                'google': {'rating': 0, 'reviews': 0},
                'indeed': {'rating': 0, 'reviews': 0},
                'ambitionbox': {'rating': 0, 'reviews': 0},
                'average_rating': 0.0,
                'total_reviews': 0,
                'sources_found': 0,
                'synthetic': True,
                'analysis': f"ℹ️ No reviews found for '{company_name}'. This could be a small/new company or lack of online presence. Exercise caution.",
                'fraud_indicators': [
                    'No company reviews found',
                    'Limited online visibility',
                    'Cannot verify company legitimacy',
                    'Proceed with caution - verify company independently'
                ]
            }
    
    def _llm_generate_reviews(self, company_name: str, role: str) -> Dict:
        """Use LLM to generate synthetic review analysis when real reviews unavailable"""
        try:
            prompt = f"""Analyze the company '{company_name}' hiring for '{role}' position.

Since no real reviews were found online, provide a fraud risk assessment:

1. Is this likely a real company or a fake/scam company?
2. What are the red flags or green flags based on the company name?
3. What should a job seeker be cautious about?

Provide response in JSON format:
{{
    "likely_legitimate": true/false,
    "confidence": 0.0-1.0,
    "analysis": "Brief analysis",
    "fraud_indicators": ["list of red flags"],
    "recommendations": ["what to verify before applying"]
}}"""

            response = self.llm_analyzer.client.models.generate_content(
                model=self.llm_analyzer.model_name,
                contents=prompt
            )
            
            import json
            import re
            
            text = response.text
            json_match = re.search(r'\{[^{}]*(?:\{[^{}]*\}[^{}]*)*\}', text, re.DOTALL)
            
            if json_match:
                analysis_data = json.loads(json_match.group())
                
                return {
                    'glassdoor': {'rating': 0, 'reviews': 0},
                    'google': {'rating': 0, 'reviews': 0},
                    'indeed': {'rating': 0, 'reviews': 0},
                    'ambitionbox': {'rating': 0, 'reviews': 0},
                    'average_rating': 0.0,
                    'total_reviews': 0,
                    'sources_found': 0,
                    'synthetic': True,
                    'llm_generated': True,
                    'analysis': analysis_data.get('analysis', 'No analysis available'),
                    'fraud_indicators': analysis_data.get('fraud_indicators', []),
                    'recommendations': analysis_data.get('recommendations', []),
                    'likely_legitimate': analysis_data.get('likely_legitimate', False),
                    'llm_confidence': analysis_data.get('confidence', 0.5)
                }
        except Exception as e:
            logger.error(f"LLM review generation error: {e}")
            return None
    
    def check_job_availability(self, job_url: str) -> Dict:
        """Check if job is still available by visiting the URL"""
        try:
            if not job_url:
                return {'is_available': False, 'status_code': 0, 'reason': 'No URL provided'}
            
            response = self.session.get(job_url, timeout=5, allow_redirects=True)
            
            availability = {
                'is_available': response.status_code == 200,
                'status_code': response.status_code,
                'reason': ''
            }
            
            if response.status_code == 200:
                content = response.text.lower()
                closed_indicators = ['job closed', 'no longer accepting', 'position filled', 
                                    'expired', 'not available', 'removed']
                
                if any(indicator in content for indicator in closed_indicators):
                    availability['is_available'] = False
                    availability['reason'] = '❌ Job posting has expired or been closed'
                else:
                    availability['reason'] = '✅ Job is currently ACTIVE'
            elif response.status_code == 404:
                availability['reason'] = '❌ Job posting not found (404)'
            else:
                availability['reason'] = f'⚠️ Cannot verify (Status: {response.status_code})'
            
            return availability
        except:
            return {'is_available': None, 'status_code': 0, 'reason': 'Could not check'}
    
    def llm_analyze_fraud(self, job_data: Dict) -> Dict:
        """Fallback rule-based fraud analysis"""
        try:
            analysis = {
                'fraud_probability': 0.0,
                'reasoning': [],
                'confidence': 0.0,
                'red_flags': [],
                'green_flags': []
            }
            
            text = f"{job_data.get('title', '')} {job_data.get('description', '')} {job_data.get('company', '')}".lower()
            
            # Check keywords
            fraud_keywords_found = []
            for keyword in self.FRAUD_KEYWORDS:
                if keyword in text:
                    fraud_keywords_found.append(keyword)
                    analysis['fraud_probability'] += 0.05
                    analysis['red_flags'].append(f"Contains '{keyword}'")
            
            if fraud_keywords_found:
                analysis['reasoning'].append(f"Found {len(fraud_keywords_found)} fraud keywords")
            
            # Check patterns
            patterns_found = 0
            for pattern in self.SUSPICIOUS_PATTERNS:
                if re.search(pattern, text, re.IGNORECASE):
                    patterns_found += 1
                    analysis['fraud_probability'] += 0.08
            
            if patterns_found:
                analysis['reasoning'].append(f"Found {patterns_found} suspicious patterns")
            
            # Description quality
            description = job_data.get('description', '')
            if len(description) < 100:
                analysis['fraud_probability'] += 0.15
                analysis['reasoning'].append("Very short description")
            
            if description.isupper() or description.count('!') > 5:
                analysis['fraud_probability'] += 0.1
                analysis['reasoning'].append("Excessive caps or exclamation marks")
            
            analysis['confidence'] = min(analysis['fraud_probability'], 1.0)
            analysis['fraud_probability'] = min(analysis['fraud_probability'], 1.0)
            analysis['recommendation'] = 'PROCEED WITH CAUTION'
            
            return analysis
        except:
            return {
                'fraud_probability': 0.5,
                'reasoning': [],
                'confidence': 0.0,
                'red_flags': [],
                'green_flags': [],
                'recommendation': 'PROCEED WITH CAUTION'
            }
    
    def _get_verdict(self, trust_score: float, company_verification: Dict, job_availability: Dict) -> str:
        """Generate final verdict message"""
        if trust_score >= 0.85:
            verdict = "✅ HIGHLY TRUSTED - Safe to apply"
        elif trust_score >= 0.7:
            verdict = "✅ TRUSTED - Company verified"
        elif trust_score >= 0.5:
            verdict = "⚠️ MODERATE - Verify details first"
        elif trust_score >= 0.3:
            verdict = "⚠️ CAUTION - Multiple red flags"
        else:
            verdict = "❌ HIGH RISK - DO NOT APPLY"
        
        if company_verification.get('is_real') and company_verification.get('confidence', 0) > 0.8:
            verdict += " | Company verified"
        
        if job_availability.get('is_available') == True:
            verdict += " | Job ACTIVE"
        elif job_availability.get('is_available') == False:
            verdict += " | Job EXPIRED"
        
        return verdict

# Singleton instance
_fraud_detector = None

def get_fraud_detector():
    """Get or create LLM fraud detector instance"""
    global _fraud_detector
    if _fraud_detector is None:
        _fraud_detector = LLMFraudDetector()
    return _fraud_detector
